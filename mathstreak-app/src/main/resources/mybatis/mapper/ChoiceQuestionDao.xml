<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lods.infrastructure.dao.IQuestionChoiceDao">
    <resultMap id="ChoiceQuestionMap" type="com.lods.infrastructure.dao.po.Question">
        <id column="id" property="questionId"/>
        <result column="question" property="description"/>
        <result column="opt_a" property="optA"/>
        <result column="opt_b" property="optB"/>
        <result column="opt_c" property="optC"/>
        <result column="opt_d" property="optD"/>
        <result column="answer" property="answer"/>
        <result column="diff" property="difficultyLevel"/>
        <result column="total_rows" property="total"/>
        <result column="ai_answer" property="aiAnswer"/>
        <result column="analysis" property="analysis"/>
    </resultMap>

    <select id="getCurrentQuestion" resultMap="ChoiceQuestionMap">
        select id, question, opt_a, opt_b, opt_c, opt_d, diff
        from choice
        where id = #{id}
    </select>

    <select id="getTotal" resultMap="ChoiceQuestionMap">
        select count(id) AS total_rows
        FROM choice;
    </select>

    <select id="queryQuestionById" resultMap="ChoiceQuestionMap">
        select id, question, opt_a, opt_b, opt_c, opt_d, answer
        from choice
        where id = #{questionId}
    </select>

    <select id="queryQuestionAnswerById" resultMap="ChoiceQuestionMap">
        select answer
        from choice
        where id = #{questionId}
    </select>

    <select id="getRangeQuestion" resultMap="ChoiceQuestionMap">
        select id, question, opt_a, opt_b, opt_c, opt_d, answer
        from choice
        limit #{pageSize} offset #{offset}
    </select>

    <update id="batchUpdateAIAnswer" parameterType="java.util.List">
        update choice
        <trim prefix="set ai_answer = case id" suffix="end">
            <foreach collection="list" item="item">
                when #{item.questionId} then #{item.aiAnswer}
            </foreach>
        </trim>
        where id in
        <foreach collection="list" item="item" open="(" close=")" separator=",">
            #{item.questionId}
        </foreach>
    </update>

    <select id="getAnswerByQuestionId" resultType="java.lang.String">
        select ai_answer
        from choice
        where id = #{questionId}
    </select>
</mapper>
