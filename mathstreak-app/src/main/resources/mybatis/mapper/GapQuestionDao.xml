<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lods.infrastructure.dao.IQuestionGapDao">
    <resultMap id="GapQuestionMap" type="com.lods.infrastructure.dao.po.Question">
        <id column="id" property="questionId"/>
        <result column="question" property="description"/>
        <result column="answer" property="answer"/>
        <result column="diff" property="difficultyLevel"/>
        <result column="total_rows" property="total"/>
        <result column="ai_answer" property="aiAnswer"/>
        <result column="analysis" property="analysis"/>
        <result column="fail_times" property="failTimes"/>
        <result column="interrupt_times" property="interruptTimes"/>
    </resultMap>

    <select id="getCurrentQuestion" resultMap="GapQuestionMap">
        select id, question, answer, diff
        from gap
        where id = #{ramId}
    </select>

    <select id="getTotal" resultMap="GapQuestionMap">
        select count(id) AS total_rows
        FROM gap;
    </select>

    <select id="queryQuestionById" resultMap="GapQuestionMap">
        select id, question, answer, diff
        from gap
        where id = #{questionId}
    </select>

    <select id="queryQuestionAnswerById" resultMap="GapQuestionMap">
        select answer
        from gap
        where id = #{questionId}
    </select>

    <select id="getRangeQuestion" resultMap="GapQuestionMap">
        select id, question, answer
        from gap
        limit #{pageSize} offset #{offset}
    </select>

    <update id="batchUpdateAIAnswer" parameterType="java.util.List">
        update gap
        <trim prefix="set ai_answer = case id" suffix="end">
            <foreach collection="list" item="item">
                when #{item.questionId} then #{item.aiAnswer}
            </foreach>
        </trim>
        where id in
        <foreach collection="list" item="item" open="(" close=")" separator=",">
            #{item.questionId}
        </foreach>
    </update>

    <select id="getAnswerByQuestionId" resultType="java.lang.String">
        select ai_answer
        from gap
        where id = #{questionId}
    </select>

    <update id="updateFailTimes" parameterType="com.lods.domain.status.model.entity.QuestionDescriptionEntity">
        update gap
        set fail_times = fail_times + 1
        where id = #{questionId}
    </update>

    <update id="updateInterruptTimes" parameterType="com.lods.domain.status.model.entity.QuestionDescriptionEntity">
        update gap
        set interrupt_times = interrupt_times + 1
        where id = #{questionId}
    </update>

    <select id="queryAllFailInterrupt" resultMap="GapQuestionMap">
        select id, fail_times, interrupt_times
        from gap
        where fail_times > 0 or interrupt_times > 0
    </select>

    <select id="queryAssignFailInterrupt" resultMap="GapQuestionMap">
        select id, fail_times, interrupt_times
        from gap
        where id = #{questionId}
    </select>
</mapper>
